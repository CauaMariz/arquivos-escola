Algoritmo "terreno2"

Var
    largura: inteiro
    compri: inteiro
    perimetro: real

Inicio


      escreval("De a largura")
      leia(largura)
      escreval("De o comprimento")
      leia(compri)
      perimetro<-4*(2*(largura)+(compri))
      escreva(perimetro)


Fimalgoritmo