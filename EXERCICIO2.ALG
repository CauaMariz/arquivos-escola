Algoritmo "exercicio2"

Var
   num, i: inteiro

Inicio

   escreva("Informe um número para ver a tabuada: ")
   leia(num)


   escreval("Tabuada de ", num, ":")


   i <- 1


   enquanto i <= 10 faca
      escreval(num, " x ", i, " = ", num * i)

      i <- i + 1
   fimenquanto

Fimalgoritmo
