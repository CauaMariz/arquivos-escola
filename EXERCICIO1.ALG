Algoritmo "exercicio1"

Var

   numi: real
   numf: real

Inicio

   escreval("Informe o número inicial:")
   leia(numi)
   escreval("Informe o número final:")
   leia(numf)

   enquanto (numi <= numf) faca
   escreva(numi, " ")
   numi := numi + 1
   fimenquanto
   
Fimalgoritmo
